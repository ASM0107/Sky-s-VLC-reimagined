/* VLC Inspired Dark Theme */

QMainWindow {
    background-color: #121212;
    color: #ffffff;
}

#controlsBar {
    background-color: #1e1e1e;
    border-top: 1px solid #333333;
}

QPushButton {
    background-color: #1a1a1a;
    color: #ffffff;
    border: 1px solid #333333;
    padding: 6px 14px;
    border-radius: 4px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #0A84FF;
    color: #ffffff;
    border-color: #0A84FF;
}

QPushButton:pressed {
    background-color: #0066CC;
}

QListWidget {
    background-color: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 4px;
}

QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid #2a2a2a;
}

QListWidget::item:selected {
    background-color: #0A84FF;
    color: #121212;
    border-radius: 2px;
}

QListWidget::item:hover:!selected {
    background-color: #333333;
}

QSlider::groove:horizontal {
    border: none;
    height: 4px;
    background: #333333;
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #0A84FF;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #ffffff;
    border: none;
    width: 10px;
    height: 10px;
    margin: -3px 0;
    border-radius: 5px;
}

QSlider::handle:horizontal:hover {
    background: #0A84FF;
}

QMenuBar {
    background-color: #121212;
    color: #e0e0e0;
}

QMenuBar::item {
    padding: 6px 12px;
    background: transparent;
}

QMenuBar::item:selected {
    background-color: #2c2c2c;
    color: #0A84FF;
}

QMenu {
    background-color: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #333333;
}

QMenu::item {
    padding: 6px 24px;
}

QMenu::item:selected {
    background-color: #0A84FF;
    color: #121212;
}

QLabel {
    color: #cccccc;
}

QComboBox {
    background-color: #2c2c2c;
    color: white;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 4px 10px;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #1e1e1e;
    color: white;
    selection-background-color: #0A84FF;
    selection-color: #121212;
}
